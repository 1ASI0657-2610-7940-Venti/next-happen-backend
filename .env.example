# ─────────────────────────────────────────────────────────────
# NextHappen backend environment variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets.
# docker-compose reads `.env` automatically.
# ─────────────────────────────────────────────────────────────

# ── Database (MySQL) ──
MYSQL_ROOT_PASSWORD=change_me_strong_password

# For docker-compose.prod.yml, provide full connection strings per service:
# DB_CONNECTION_IAM=server=<host>;database=nexthappen_iam;user=<user>;password=<pass>
# DB_CONNECTION_EVENTS=server=<host>;database=nexthappen_events;user=<user>;password=<pass>
# DB_CONNECTION_TICKETS=server=<host>;database=nexthappen_tickets;user=<user>;password=<pass>
# DB_CONNECTION_ENGAGEMENT=server=<host>;database=nexthappen_engagement;user=<user>;password=<pass>
# DB_CONNECTION_NOTIFICATIONS=server=<host>;database=nexthappen_notifications;user=<user>;password=<pass>

# ── JWT (must be identical across all services + gateway) ──
# Generate a strong random key of at least 32 bytes, e.g.:  openssl rand -base64 48
JWT_KEY=change_me_min_32_byte_random_secret
JWT_ISSUER=nexthappen
JWT_AUDIENCE=nexthappen-users

# ── CORS: the public origin of the frontend (Vercel URL in prod) ──
FRONTEND_ORIGIN=http://localhost:5173

# ── RabbitMQ ──
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_USE_SSL=false

# ── Stripe (pagos de entradas) ──
# Obtén tus claves de PRUEBA en https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY debe empezar con sk_test_ en modo prueba.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# El webhook secret (whsec_...) lo entrega `stripe listen` o el dashboard de webhooks.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Moneda ISO en minúsculas (Stripe la exige así). Perú: pen
STRIPE_CURRENCY=pen

# ── Database schema auto-create (prod: prefer false + real migrations) ──
DB_AUTO_CREATE=true
