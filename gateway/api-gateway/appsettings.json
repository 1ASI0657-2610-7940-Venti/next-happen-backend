{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "events-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        }
      },
      "stands-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/stands/{**catch-all}"
        }
      },
      "tickets-route": {
        "ClusterId": "ticket-cluster",
        "Match": {
          "Path": "/api/tickets/{**catch-all}"
        }
      },
      "user-tickets-route": {
        "ClusterId": "ticket-cluster",
        "Match": {
          "Path": "/api/users/{userId}/tickets/{**catch-all}"
        },
        "Order": 1
      },
      "event-tickets-route": {
        "ClusterId": "ticket-cluster",
        "Match": {
          "Path": "/api/events/{eventId}/tickets/{**catch-all}"
        },
        "Order": 1
      },
      "saved-events-route": {
        "ClusterId": "engagement-cluster",
        "Match": {
          "Path": "/api/users/{userId}/saved-events/{**catch-all}"
        },
        "Order": 0
      },
      "metrics-route": {
        "ClusterId": "engagement-cluster",
        "Match": {
          "Path": "/api/metrics/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "iam-cluster": {
        "Destinations": {
          "iam-service": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "event-cluster": {
        "Destinations": {
          "event-service": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "ticket-cluster": {
        "Destinations": {
          "ticket-service": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "engagement-cluster": {
        "Destinations": {
          "engagement-service": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-service": {
            "Address": "http://localhost:5005"
          }
        }
      }
    }
  }
}
